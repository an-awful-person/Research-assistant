# Keys shared with everyone who uses this assistant on this computer. Copy this file to .env and fill in what you have:
#   cp .env.example .env
# Each is optional. Without them, everyone enters their own key in the agent settings instead.
# Everyone who can open the assistant uses these keys and their limits, so leave them empty where people should
# use their own, such as at work. Never commit .env: it is in .gitignore.

# Wikipedia agent: a Wikimedia OAuth 2.0 app with the "Client credentials" grant.
# Register one at https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
WIKIPEDIA_CLIENT_ID=
WIKIPEDIA_CLIENT_SECRET=

# arXiv agent (optional, raises the daily search limit): a free key from https://openalex.org/settings/api
OPENALEX_API_KEY=
